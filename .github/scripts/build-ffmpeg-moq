#!/usr/bin/env bash
#
# build-ffmpeg-moq - configures and builds ffmpeg with the moq muxer in
# <work dir>/ffmpeg, linking libmoq, x264, FreeType, HarfBuzz, Fontconfig
# and (on Windows) zlib statically through pkg-config, from what the build-*
# scripts installed. On Windows it puts fonts\fonts.conf next to ffmpeg.exe.
#
#   build-ffmpeg-moq
#
# On Windows ffmpeg is built with MSVC, like libmoq: run it from an MSYS2
# shell that inherits an x64 MSVC developer environment.
#
# Environment (optional): MOQ_WORK_DIR.

set -euo pipefail
source "$(dirname "$0")/common.sh"

[ $# -eq 0 ] || die "unknown argument: $1"

require_dep libmoq "${libmoq_prefix}" build-libmoq
require_dep x264 "${x264_prefix}" build-x264
require_dep FreeType "${freetype_prefix}" build-freetype
require_dep HarfBuzz "${harfbuzz_prefix}" build-harfbuzz
require_dep Fontconfig "${fontconfig_prefix}" build-fontconfig
pkg_config_path="${libmoq_prefix}/lib/pkgconfig:${x264_prefix}/lib/pkgconfig"
# FreeType ahead of the copies vcpkg puts next to HarfBuzz and Fontconfig on
# Windows.
pkg_config_path="${pkg_config_path}:${freetype_prefix}/lib/pkgconfig:${harfbuzz_prefix}/lib/pkgconfig"
pkg_config_path="${pkg_config_path}:${fontconfig_prefix}/lib/pkgconfig"
configure_args=(
    # Link nothing the build host happens to have.
    --disable-autodetect
    --pkg-config-flags=--static
    --enable-gpl
    --enable-libx264
    --enable-libmoq
    --enable-zlib
    --enable-libfreetype
    --enable-libharfbuzz
    --enable-libfontconfig
    --disable-doc
    --disable-ffplay
)
if [ "${platform}" = windows ]; then
    require_dep zlib "${zlib_prefix}" build-zlib
    require_msvc
    pkg_config_path="${pkg_config_path}:${zlib_prefix}/lib/pkgconfig"
    configure_args+=(--toolchain=msvc)
fi
if [ "${platform}" = macos ]; then
    configure_args+=(
        --enable-avfoundation
        --enable-videotoolbox
        --enable-audiotoolbox
    )
fi

log 'Configuring ffmpeg...'
rm -rf "${build_dir}"
mkdir -p "${build_dir}"
cd "${build_dir}"
PKG_CONFIG_PATH="${pkg_config_path}" \
    "${project_root}/configure" "${configure_args[@]}" \
    || { tail -n 60 ffbuild/config.log >&2; die 'ffmpeg configure failed'; }

log 'Building ffmpeg...'
make -j"${jobs}"

# Fontconfig on Windows reads fonts\fonts.conf next to the executable.
if [ "${platform}" = windows ]; then
    mkdir -p fonts
    cp "${script_dir}/fonts.conf" fonts/
fi
