#!/usr/bin/env bash
#
# package-ffmpeg-moq - packages the ffmpeg that build-ffmpeg-moq built into
# <work dir>/out: ffmpeg and ffprobe with BUILDINFO.txt, the license and (on
# Windows) fonts\fonts.conf, and the debug symbols apart in out/debug.
#
#   package-ffmpeg-moq
#
# Environment (optional): MOQ_WORK_DIR.

set -euo pipefail
source "$(dirname "$0")/common.sh"

[ $# -eq 0 ] || die "unknown argument: $1"
[ -x "${build_dir}/ffmpeg${exe}" ] || die "no ffmpeg in ${build_dir}: run build-ffmpeg-moq first"
cd "${build_dir}"

deps=("${x264_prefix}" "${libmoq_prefix}" "${openssl_prefix}" "${freetype_prefix}" "${harfbuzz_prefix}"
    "${fontconfig_prefix}")
[ "${platform}" != windows ] || deps+=("${zlib_prefix}")

# Commands to start from, for BUILDINFO.txt.
examples() {
    local relay='moqt://relay.example.com:4433/moq-relay'
    local video='-c:v libx264 -preset veryfast -tune zerolatency -pix_fmt yuv420p -g 60'
    local rate='-b:v 2M -maxrate 2M -bufsize 4M'
    local clock="text='%{localtime\:%X.%3N}':x=10:y=10:fontsize=24:fontcolor=white:box=1:boxcolor=black"
    printf 'Examples. Use your relay'"'"'s URL; for one with a self-signed certificate\n'
    printf 'add -moq_insecure 1 (local tests only).\n\n'
    case ${platform} in
    windows)
        cat <<EOF
Publish a test pattern with a tone (Command Prompt; in PowerShell end the
lines with \` instead of ^):
  ffmpeg.exe -re -f lavfi -i testsrc2=size=1280x720:rate=30 ^
    -f lavfi -i sine=frequency=440 ^
    ${video} ^
    ${rate} -c:a aac -b:a 128k ^
    -f moq -moq_namespace demo-live ${relay}

List the cameras and microphones:
  ffmpeg.exe -hide_banner -list_devices true -f dshow -i dummy

Publish a camera and a microphone by those names, with the local time on
the video:
  ffmpeg.exe -f dshow -rtbufsize 100M -framerate 30 -video_size 1280x720 ^
    -i video="Integrated Camera":audio="Microphone" ^
    -vf "drawtext=${clock}" ^
    ${video} ^
    ${rate} -c:a aac -b:a 128k ^
    -f moq -moq_namespace demo-camera ${relay}
EOF
        ;;
    macos)
        cat <<EOF
Publish a test pattern with a tone:
  ./ffmpeg -re -f lavfi -i testsrc2=size=1280x720:rate=30 \\
    -f lavfi -i sine=frequency=440 \\
    ${video} \\
    ${rate} -c:a aac -b:a 128k \\
    -f moq -moq_namespace demo-live ${relay}

List the cameras and microphones:
  ./ffmpeg -hide_banner -f avfoundation -list_devices true -i ""

Publish camera 0 and microphone 0, with the local time on the video. macOS
asks once for the terminal to use them:
  ./ffmpeg -f avfoundation -framerate 30 -video_size 1280x720 -i "0:0" \\
    -vf "drawtext=${clock}" \\
    ${video} \\
    ${rate} -c:a aac -b:a 128k \\
    -f moq -moq_namespace demo-camera ${relay}
EOF
        ;;
    *)
        cat <<EOF
Publish a test pattern with a tone:
  ./ffmpeg -re -f lavfi -i testsrc2=size=1280x720:rate=30 \\
    -f lavfi -i sine=frequency=440 \\
    ${video} \\
    ${rate} -c:a aac -b:a 128k \\
    -f moq -moq_namespace demo-live ${relay}

Publish a camera (ls /dev/video* lists them), with the local time on the
video:
  ./ffmpeg -f v4l2 -framerate 30 -video_size 1280x720 -i /dev/video0 \\
    -vf "drawtext=${clock}" \\
    ${video} \\
    ${rate} \\
    -f moq -moq_namespace demo-camera ${relay}
EOF
        ;;
    esac
    printf '\nWithout -vf the video goes out as it is. The catalog needs a bitrate\n'
    printf 'for every track, so keep -maxrate (or -b) on the encoder.\n\n'
    printf 'drawtext picks a font by name with font= (Sans by default) or takes\n'
    printf 'one by path with fontfile=. '
    case ${platform} in
    windows)
        printf 'It finds the Windows fonts through\n'
        printf 'fonts\\fonts.conf, so keep the fonts folder next to ffmpeg.exe.\n\n'
        ;;
    macos)
        printf 'It finds the macOS fonts on its own;\n'
        printf 'Sans is Helvetica.\n\n'
        ;;
    *)
        printf 'It uses the machine'"'"'s fonts and its\n'
        printf 'Fontconfig settings in /etc/fonts. A server without them needs a font\n'
        printf 'package, on Debian or Ubuntu: apt install fontconfig-config fonts-dejavu-core\n\n'
        ;;
    esac
}

ffmpeg_revision=$(git -C "${project_root}" rev-parse --short=10 HEAD)
git -C "${project_root}" diff --quiet HEAD || ffmpeg_revision="${ffmpeg_revision}-dirty"
name="ffmpeg-moq-${platform}-${arch}-${ffmpeg_revision}"
stage="${out_dir}/${name}"

log "Packaging ${name}..."
rm -rf "${out_dir}"
mkdir -p "${stage}" "${out_dir}/debug"
cp "ffmpeg${exe}" "ffprobe${exe}" "${project_root}/COPYING.GPLv2" "${stage}/"
[ "${platform}" != windows ] || cp -R fonts "${stage}/"
{
    printf 'ffmpeg with the MoQ muxer (libmoq), %s %s.\n\n' "${platform}" "${arch}"
    printf '  ffmpeg    %s\n' "${ffmpeg_revision}"
    for dep in "${deps[@]}"; do
        cat "${dep}/buildinfo"
    done
    printf '\n'
    case ${platform} in
    windows)
        printf 'Built on:\n  %s, %s\n' \
            "$(cmd //c ver 2>/dev/null | tr -d '\r' | grep . || echo Windows)" \
            "$({ cl 2>&1 || true; } | tr -d '\r' | grep -m1 '^Microsoft')"
        printf 'Runs on:\n  Windows 10 or later, x86_64\n\n'
        ;;
    macos)
        printf 'Built on:\n  macOS %s, %s\n' "$(sw_vers -productVersion)" \
            "$(xcrun clang --version | head -1)"
        printf 'Runs on:\n  macOS %s or later\n\n' "${MACOSX_DEPLOYMENT_TARGET}"
        ;;
    *)
        printf 'Built on:\n  %s, %s\n\n' \
            "$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-unknown}")" \
            "$(ldd --version | head -1)"
        ;;
    esac
    printf 'configure:\n  %s\n\n' "$(sed -n 's/^FFMPEG_CONFIGURATION=//p' ffbuild/config.mak)"
    printf 'Runtime dependencies:\n'
    runtime_deps "ffmpeg${exe}" | awk '{print "  " $1}' | sort -u
    if [ "${platform}" = windows ]; then
        printf '\nCheck it runs:  ffmpeg.exe -hide_banner -h muxer=moq\n\n'
    else
        printf '\nCheck it runs:  ./ffmpeg -hide_banner -h muxer=moq\n\n'
    fi
    examples
    if [ "${platform}" = macos ]; then
        printf 'The binaries are not signed. If macOS blocks them after a browser\n'
        printf 'download, run:  xattr -d com.apple.quarantine ffmpeg ffprobe\n\n'
    fi
    printf 'A -dirty suffix means the build came from an uncommitted tree and is\n'
    printf 'not reproducible.\n\n'
    printf 'Built with --enable-gpl --enable-libx264: this binary is GPLv2 or later\n'
    printf '(see COPYING.GPLv2). The sources are the revisions listed above.\n'
} >"${stage}/BUILDINFO.txt"

if [ "${platform}" = windows ]; then
    (cd "${out_dir}" && zip -qr "${name}.zip" "${name}")
else
    tar -C "${out_dir}" -cJf "${out_dir}/${name}.tar.xz" "${name}"
fi
rm -rf "${stage}"

# Debug symbols for the stripped binaries, apart from the package.
case ${platform} in
macos)
    quiet dsymutil dsymutil ffmpeg_g -o "${out_dir}/${name}.dSYM"
    ditto -c -k --keepParent "${out_dir}/${name}.dSYM" "${out_dir}/debug/${name}.dSYM.zip"
    rm -rf "${out_dir}/${name}.dSYM"
    ;;
windows)
    # MSVC keeps the debug info in the PDBs, not in the binaries.
    zip -qj "${out_dir}/debug/${name}.debug.zip" ./*.pdb
    ;;
*)
    xz -T0 -c ffmpeg_g >"${out_dir}/debug/${name}.debug.xz"
    ;;
esac

ls -lR "${out_dir}" >&2
