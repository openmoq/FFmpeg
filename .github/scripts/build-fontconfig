#!/usr/bin/env bash
#
# build-fontconfig - builds Fontconfig as a static library, so drawtext finds
# a font by name without fontfile=; build-ffmpeg-moq finds it with
# pkg-config. On Linux it reads the machine's own /etc/fonts. macOS has none,
# so fontconfig-macos.patch gives it the macOS font folders and generic font
# names built in. On Windows it installs it from vcpkg, and fonts\fonts.conf
# next to ffmpeg.exe configures it.
#
#   build-fontconfig                    build into <work dir>/deps/fontconfig
#   build-fontconfig --print-deps-key   cache key of what it builds
#
# Needs meson, ninja and gperf, and on Linux a static libexpat. Environment:
# VCPKG_INSTALLATION_ROOT on Windows; FONTCONFIG_REPO and FONTCONFIG_REF,
# MOQ_WORK_DIR (optional).

set -euo pipefail
source "$(dirname "$0")/common.sh"

FONTCONFIG_REPO="${FONTCONFIG_REPO:-https://gitlab.freedesktop.org/fontconfig/fontconfig.git}"
# 2.18.3
FONTCONFIG_REF="${FONTCONFIG_REF:-0f236723a3c26bd9745e32ba2b3ee21e5f809295}"
macos_patch="${script_dir}/fontconfig-macos.patch"

if [ "${platform}" = windows ]; then
    case ${1:-} in
    '') ;;
    --print-deps-key)
        printf '%s-fontconfig-vcpkg\n' "${platform_id}"
        exit 0
        ;;
    *) die "unknown argument: $1" ;;
    esac
    if [ -r "${fontconfig_prefix}/buildinfo" ]; then
        log 'Fontconfig already installed, skipping vcpkg'
        exit 0
    fi
    log "Installing Fontconfig from vcpkg (${vcpkg_triplet})..."
    rm -rf "${deps_dir}/fontconfig"
    # freetype[core] as for HarfBuzz, or vcpkg adds FreeType's PNG, bzip2,
    # brotli and zlib support.
    vcpkg_install fontconfig "${deps_dir}/fontconfig" 'freetype[core]' fontconfig
    printf '  Fontconfig %s (vcpkg %s, static)\n' \
        "$(vcpkg_version "${deps_dir}/fontconfig" fontconfig)" "${vcpkg_triplet}" \
        >"${fontconfig_prefix}/buildinfo"
    exit 0
fi

fontconfig_revision=$(resolve_revision "${FONTCONFIG_REPO}" "${FONTCONFIG_REF}")

case ${1:-} in
'') ;;
--print-deps-key)
    printf '%s-fontconfig_%s\n' "${platform_id}" "${fontconfig_revision:0:10}"
    exit 0
    ;;
*) die "unknown argument: $1" ;;
esac

require_dep FreeType "${freetype_prefix}" build-freetype

# Rebuilt when Fontconfig, the FreeType it links or the macOS patch changes.
stamp="${fontconfig_prefix}/.revision"
stamp_value="${fontconfig_revision} freetype-$(cat "${freetype_prefix}/.revision")"
[ "${platform}" != macos ] || stamp_value="${stamp_value} patch-$(git hash-object "${macos_patch}")"
src_dir="${deps_dir}/fontconfig-src"

if up_to_date "${stamp}" "${stamp_value}"; then
    log "Fontconfig ${fontconfig_revision:0:10} already installed, skipping build"
    exit 0
fi

# The machine's own configuration and cache, wherever ffmpeg runs.
meson_args=(
    --prefix="${fontconfig_prefix}" --libdir=lib
    --buildtype=release --default-library=static -Db_staticpic=true
    -Dxml-backend=expat -Ddoc=disabled -Dnls=disabled -Dtests=disabled
    -Dtools=disabled -Dcache-build=disabled
    -Dbaseconfig-dir=/etc/fonts -Dconfig-dir=/etc/fonts/conf.d
    -Dtemplate-dir=/usr/share/fontconfig/conf.avail
    -Dxml-dir=/usr/share/xml/fontconfig -Dcache-dir=/var/cache/fontconfig
)
case ${platform} in
linux)
    expat_libdir=$(pkg-config --variable=libdir expat) || die 'expat not found: install libexpat1-dev'
    [ -r "${expat_libdir}/libexpat.a" ] || die "no static libexpat in ${expat_libdir}"
    pkg_config_env=(PKG_CONFIG_PATH="${freetype_prefix}/lib/pkgconfig")
    ;;
macos)
    # Only build-freetype's FreeType, and expat from the SDK, never Homebrew.
    pkg_config_env=(PKG_CONFIG_LIBDIR="${freetype_prefix}/lib/pkgconfig")
    # The font folders, as Homebrew's Fontconfig has them.
    meson_args+=('-Ddefault-fonts-dirs=/System/Library/Fonts,/Library/Fonts,~/Library/Fonts')
    ;;
esac

log "Building Fontconfig ${fontconfig_revision:0:10} (static)..."
rm -rf "${fontconfig_prefix}"
mkdir -p "${deps_dir}"
fetch_source "${FONTCONFIG_REPO}" "${fontconfig_revision}" "${src_dir}"
if [ "${platform}" = macos ]; then
    git -C "${src_dir}" apply "${macos_patch}" || die "${macos_patch##*/} does not apply"
fi
quiet fontconfig env "${pkg_config_env[@]}" \
    meson setup "${src_dir}/build" "${src_dir}" "${meson_args[@]}"
quiet fontconfig meson compile -C "${src_dir}/build" -j "${jobs}"
# Only the library, headers and .pc: the configuration is the machine's.
quiet fontconfig meson install -C "${src_dir}/build" --tags devel
rm -rf "${src_dir}"

pc="${fontconfig_prefix}/lib/pkgconfig/fontconfig.pc"
if [ "${platform}" = linux ]; then
    # -lexpat would pick the shared libexpat: ask GNU ld for the static one.
    expat_libs="-L${expat_libdir} -l:libexpat.a"
    sed -i -E -e '/^Requires(\.private)?:/{s/(,[[:space:]]*)?expat[^,]*//; s/:[[:space:]]*,/:/;}' \
        -e "/^Libs.private:/s|\$| ${expat_libs}|" "${pc}"
    grep -q '^Libs.private:' "${pc}" || printf 'Libs.private: %s\n' "${expat_libs}" >>"${pc}"
    printf '  Fontconfig %s @ %s\n' "${FONTCONFIG_REPO}" "${fontconfig_revision}" >"${fontconfig_prefix}/buildinfo"
else
    printf '  Fontconfig %s @ %s + %s\n' "${FONTCONFIG_REPO}" "${fontconfig_revision}" "${macos_patch##*/}" \
        >"${fontconfig_prefix}/buildinfo"
fi
printf '%s\n' "${stamp_value}" >"${stamp}"
